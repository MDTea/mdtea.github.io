+/* ==========================================================================
+   Projects Section — "editor window" cards
+   The one distinctive, repeated motif on the page: a stylized code-editor
+   window, used for both the live GitHub repo previews and the capstone
+   video. Traffic-light dots + a filename tab stand in for a section header.
+   ========================================================================== */
+
+.projects-section {
+  background: var(--bg-void);
+}
+
+.editor-grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 28px;
+}
+
+.editor-window {
+  background: var(--bg-panel);
+  border: 1px solid var(--border-soft);
+  border-radius: 10px;
+  overflow: hidden;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
+  transition: border-color 0.2s ease, transform 0.2s ease;
+}
+
+.editor-window:hover {
+  border-color: var(--border-strong);
+  transform: translateY(-2px);
+}
+
+.editor-window--wide {
+  grid-column: 1 / -1;
+}
+
+.editor-titlebar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 12px 16px;
+  background: var(--bg-panel-alt);
+  border-bottom: 1px solid var(--border-soft);
+}
+
+.editor-dot {
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  display: inline-block;
+}
+
+.dot-red {
+  background: #d9718a;
+}
+
+.dot-yellow {
+  background: #d9b16a;
+}
+
+.dot-green {
+  background: #7fbf8f;
+}
+
+.editor-tab {
+  font-family: var(--font-mono);
+  font-size: 0.85rem;
+  color: var(--text-secondary);
+  margin-left: 8px;
+}
+
+.editor-badge {
+  margin-left: auto;
+  font-family: var(--font-mono);
+  font-size: 0.75rem;
+  color: var(--accent-primary);
+  background: rgba(167, 139, 250, 0.12);
+  border: 1px solid rgba(167, 139, 250, 0.3);
+  padding: 3px 10px;
+  border-radius: 999px;
+}
+
+.editor-body {
+  padding: 24px;
+}
+
+.editor-blurb {
+  color: var(--text-secondary);
+  line-height: 1.6;
+  margin-bottom: 20px;
+}
+
+.video-embed {
+  position: relative;
+  width: 100%;
+  padding-top: 56.25%; /* 16:9 */
+  border-radius: 8px;
+  overflow: hidden;
+  background: #000;
+  margin-bottom: 8px;
+}
+
+.video-embed iframe {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+
+.video-credit {
+  font-size: 0.85rem;
+  color: var(--text-tertiary);
+  margin-bottom: 24px;
+}
+
+.repo-card-body {
+  display: flex;
+  flex-direction: column;
+}
+
+.repo-description {
+  color: var(--text-secondary);
+  line-height: 1.6;
+  margin-bottom: 16px;
+  min-height: 3.2em;
+}
+
+.repo-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  font-family: var(--font-mono);
+  font-size: 0.82rem;
+  color: var(--text-tertiary);
